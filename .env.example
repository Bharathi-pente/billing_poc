# Copy this file to .env in this folder and fill in the values you need.
# Keep .env private; never commit API tokens.

# Required only for the interactive UI. Use a sandbox token when testing.
METRONOME_API_TOKEN=
METRONOME_BASE=https://api.metronome.com

# Interactive UI server port.
TOKEN_POC_PORT=8792

# Stop new turns / stop local ingest at this percent of credit used.
# Defaults to 99 when unset; valid values are from 1 to 100.
PLAN_STOP_THRESHOLD_PERCENT=99

# Credit alert milestones are configured per customer in the UI.
# Defaults: 50, 75, 85, 90, 95 percent.
